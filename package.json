{
  "name": "@linchpinagency/ui",
  "version": "0.1.0",
  "description": "Linchpin's admin component library for WordPress plugins \u2014 the chrome and the brand, on top of @wordpress/admin-ui.",
  "author": "Linchpin <sayhi@linchpin.com>",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "main": "build-module/index.js",
  "module": "build-module/index.js",
  "exports": {
    ".": "./build-module/index.js",
    "./style.css": "./build-style/style.css",
    "./style.scss": "./src/style.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "build-module",
    "build-style",
    "src"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:style",
    "build:js": "BABEL_ENV=module babel src --out-dir build-module --extensions .js,.jsx --ignore \"**/*.test.js\",\"**/test/**\",\"**/*.stories.jsx\" --copy-files --no-copy-ignored",
    "build:style": "sass --no-source-map --load-path=node_modules src/style.scss build-style/style.css",
    "clean": "rm -rf build-module build-style storybook-static",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "test": "wp-scripts test-unit-js",
    "test:watch": "wp-scripts test-unit-js --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "npm run clean && npm run build",
    "prepare": "husky || true",
    "commitlint": "commitlint --edit",
    "prestorybook": "npm run build",
    "prebuild-storybook": "npm run build"
  },
  "peerDependencies": {
    "@wordpress/admin-ui": ">=2.0.0",
    "@wordpress/components": ">=39.0.0",
    "@wordpress/data": ">=10.0.0",
    "@wordpress/element": ">=8.0.0",
    "@wordpress/i18n": ">=6.0.0",
    "@wordpress/icons": ">=16.0.0",
    "@wordpress/notices": ">=5.0.0",
    "@wordpress/theme": ">=2.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@linchpinagency/commitlint-config": "^1.3.1",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@wordpress/admin-ui": "^2.10.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/data": "^10.55.0",
    "@wordpress/element": "^8.7.0",
    "@wordpress/i18n": "^6.28.0",
    "@wordpress/icons": "^16.0.0",
    "@wordpress/notices": "^5.55.0",
    "@wordpress/scripts": "^35.0.0",
    "@wordpress/theme": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.95.0",
    "sass-embedded": "^1.104.1",
    "storybook": "^10.6.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linchpin/ui.git"
  },
  "bugs": {
    "url": "https://github.com/linchpin/ui/issues"
  },
  "homepage": "https://github.com/linchpin/ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wordpress",
    "wp-admin",
    "components",
    "linchpin"
  ],
  "lint-staged": {
    "*.{js,jsx}": [
      "npx wp-scripts format",
      "npx wp-scripts lint-js"
    ],
    "*.scss": [
      "npx wp-scripts lint-style"
    ]
  }
}
