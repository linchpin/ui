{
	"presets": [
		[
			"@babel/preset-env",
			{
				"bugfixes": true,
				"modules": false,
				"targets": { "browsers": [ "defaults" ] }
			}
		],
		[ "@babel/preset-react", { "runtime": "automatic" } ]
	],
	"env": {
		"module": {
			"plugins": [ "./scripts/babel-plugin-add-js-extension.cjs" ]
		},
		"test": {
			"presets": [
				[ "@babel/preset-env", { "targets": { "node": "current" } } ],
				[ "@babel/preset-react", { "runtime": "automatic" } ]
			]
		}
	}
}
